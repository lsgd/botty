# OpenAI API Configuration
OPENAI_API_KEY=sk-your-api-key-here

# Authorized WhatsApp Numbers (comma-separated)
# Format: +1234567890,+0987654321
# These are the phone numbers that can use commands
AUTHORIZED_NUMBERS=+1234567890,+0987654321

# Bot Language (en or de)
# Controls the language of bot messages and responses
BOT_LANGUAGE=en

# WhatsApp Web Version (optional)
# Pin to a specific WhatsApp Web version for stability
# Example: 2.3000.1029960097-alpha
# If not set, uses the latest version automatically
# You can find the list of versions in the recent releases here: https://github.com/wppconnect-team/wa-version/releases
# WEB_VERSION=2.3000.1029960097-alpha

# Timezone (optional, IANA timezone identifier)
# Used for scheduling birthday wishes and reminders
# If not set, uses the system timezone
# Examples: Europe/Zurich, Europe/Berlin, America/New_York, Asia/Tokyo
# BOT_TIMEZONE=Europe/Zurich

# Profile Cinema (optional)
# Provide a movie file to rotate the profile photo frame-by-frame
# PROFILE_MOVIE_PATH=./data/profile.mp4
# PROFILE_MESSAGE_INTERVAL=25
# PROFILE_FRAME_MAX_KB=100

# Debug Mode (optional)
# Enable logging for all WhatsApp events (default: false)
# Useful for debugging and understanding event flow
# DEBUG=true
